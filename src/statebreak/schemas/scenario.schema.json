{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://statebreak.dev/schemas/scenario.schema.json",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "seed",
    "clock",
    "world",
    "faults",
    "agent_task",
    "oracles"
  ],
  "properties": {
    "schema": {
      "const": "statebreak.scenario/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "clock": {
      "type": "object",
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "step_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "world": {
      "type": "object"
    },
    "faults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "at",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "agent_task": {
      "type": "object",
      "required": [
        "instruction",
        "tools"
      ],
      "properties": {
        "instruction": {
          "type": "string"
        },
        "required_claim": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "oracles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "expectations": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
